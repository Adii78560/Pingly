<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.RaiEnterprise.Relyvo.refresh</string>
		<string>com.RaiEnterprise.Relyvo.pttsync</string>
		<string>com.RaiEnterprise.Relayn.refresh</string>
		<string>com.RaiEnterprise.Relayn.pttsync</string>
		<string>com.RaiEnterprise.Pingly.refresh</string>
		<string>com.RaiEnterprise.Pingly.pttsync</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Relyvo</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Relyvo</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Relyvo requires Bluetooth access to discover nearby emergency peer devices, scan RSSI signal proximity, and relay off-grid SOS mesh messages.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Relyvo uses Bluetooth to advertise emergency beacon signals to nearby rescue nodes.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_relayn-mesh._tcp</string>
		<string>_relayn-mesh._udp</string>
		<string>_relyvo-mesh._tcp</string>
		<string>_relyvo-mesh._udp</string>
		<string>_pingly-mesh._tcp</string>
		<string>_pingly-mesh._udp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Relyvo uses the camera to scan QR codes for secure channel pairing.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Relyvo uses local peer-to-peer Wi-Fi network protocols to transfer message drops and broadcast real-time Push-To-Talk radio voice calls.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Relyvo uses background location updates to keep your SOS beacon location updated in emergency situations.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Relyvo attaches offline GPS coordinates to emergency SOS distress pings for search and rescue operations.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Relyvo requires microphone access to record and transmit live Push-To-Talk (PTT) radio voice communications.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Relyvo uses Speech Recognition to transcribe Walkie-Talkie voice broadcasts in real-time so you can read missed messages.</string>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>audio</string>
		<string>voip</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
		<string>bluetooth-le</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
